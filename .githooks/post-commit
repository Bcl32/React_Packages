#!/bin/bash
# Post-commit hook: auto-generate a changeset for modified @bcl32/* packages
# that no pending changeset already names. Amends the commit to include it.
# PAI_SKIP_CHANGESET prevents infinite recursion when amending.

[ "$PAI_SKIP_CHANGESET" = "1" ] && exit 0

# Skip merge commits and CI version commits
commit_msg=$(git log -1 --format=%s)
[[ "$commit_msg" == "chore: version packages"* ]] && exit 0
[ "$(git rev-parse -q --verify MERGE_HEAD 2>/dev/null)" ] && exit 0

# Known workspace packages
PACKAGES=(utils data-utils hooks charts datatable filters forms navigation themes command-palette account)

commit_files=$(git diff-tree --no-commit-id --name-only -r HEAD)

# Print a changeset's frontmatter (between the first two `---` lines) from HEAD
frontmatter() {
  git show "HEAD:$1" 2>/dev/null | awk 'NR==1 && /^---$/ {f=1; next} f && /^---$/ {exit} f'
}

# An empty changeset in this commit (`pnpm changeset --empty`) means
# "release nothing, on purpose" — respect it and add nothing.
for f in $(echo "$commit_files" | grep '^\.changeset/.*\.md$' | grep -v 'README.md'); do
  frontmatter "$f" | grep -q '@bcl32/' || exit 0
done

# Packages already named by a pending changeset at HEAD — this commit's own
# (a manual `pnpm changeset`) or an earlier one not yet versioned by CI
named=$(git ls-tree --name-only HEAD .changeset/ | grep '\.md$' | grep -v 'README.md' |
  while read -r f; do frontmatter "$f"; done |
  sed -nE "s/^[[:space:]]*[\"']?@bcl32\/([a-z0-9-]+)[\"']?[[:space:]]*:.*/\1/p")

# Packages this commit modified that no pending changeset names. A manual
# changeset covering only some of them used to make the hook skip the rest,
# leaving them "unreleased" on the dashboard.
changed=()
for pkg in "${PACKAGES[@]}"; do
  echo "$commit_files" | grep -q "^${pkg}/" || continue
  echo "$named" | grep -qx "$pkg" && continue
  changed+=("$pkg")
done

# Nothing to do if every touched package is already covered
[ ${#changed[@]} -eq 0 ] && exit 0

# Generate a short random name for the changeset file
slug=$(head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n' | head -c 8)
changeset_file=".changeset/auto-${slug}.md"

# Build the changeset YAML frontmatter
{
  echo "---"
  for pkg in "${changed[@]}"; do
    echo "\"@bcl32/${pkg}\": patch"
  done
  echo "---"
  echo ""
  echo "$commit_msg"
} > "$changeset_file"

# Stage and amend the commit to include the changeset
git add "$changeset_file"
PAI_SKIP_CHANGESET=1 git commit --amend --no-edit

echo "Auto-changeset: created ${changeset_file} for ${changed[*]}"
