exports[`generated GLSL per finish > wood: snapshot, and every piece lands in three's shader 1`] = `
{
  "diffuse": "
  {
    vec3 wp = vFinishPos / FINISH_SCALE;
    float rings = sin((wp.x + 2.5 * finishFbm(wp * 6.0)) * 40.0);
    float fibre = finishNoise(vec3(wp.x * 6.0, wp.y * 120.0, wp.z * 120.0));
    diffuseColor.rgb *= mix(0.85, 1.08, smoothstep(-0.6, 0.6, rings));
    diffuseColor.rgb *= 0.95 + 0.1 * fibre;
  }
",
  "header": "#define FINISH_SCALE 42.000000
#define FINISH_ZMIN -7.500000
#define FINISH_ZRANGE 15.000000
uniform float uFinishTime;
varying vec3 vFinishPos;
",
  "light": "",
}
`;
