exports[`generated GLSL per finish > metal: snapshot, and every piece lands in three's shader 1`] = `
{
  "diffuse": "
  {
    vec3 mp = vFinishPos / FINISH_SCALE;
    float streak = finishNoise(vec3(mp.x * 3.0, mp.y * 80.0, mp.z * 80.0));
    diffuseColor.rgb *= 0.93 + 0.14 * streak;
  }
",
  "header": "#define FINISH_SCALE 42.000000
#define FINISH_ZMIN -7.500000
#define FINISH_ZRANGE 15.000000
uniform float uFinishTime;
varying vec3 vFinishPos;
",
  "light": "",
}
`;

exports[`generated GLSL per finish > silk: snapshot, and every piece lands in three's shader 1`] = `
{
  "diffuse": "",
  "header": "#define FINISH_SCALE 42.000000
#define FINISH_ZMIN -7.500000
#define FINISH_ZRANGE 15.000000
uniform float uFinishTime;
varying vec3 vFinishPos;
",
  "light": "
  {
    vec3 silkDir = normalize(vViewPosition);
    float silkFres = pow(1.0 - abs(dot(silkDir, normalize(normal))), 2.5);
    float silkBand = 0.5 + 0.5 * sin(
      (vFinishPos.x + vFinishPos.y + 2.0 * vFinishPos.z) / FINISH_SCALE * 9.0
      + uFinishTime * 0.6);
    outgoingLight += vec3(0.661587, 0.696504, 0.861340) * silkFres * (0.12 + 0.28 * silkBand);
  }
",
}
`;

exports[`generated GLSL per finish > silk-multi: snapshot, and every piece lands in three's shader 1`] = `
{
  "diffuse": "
  {
    float gt = clamp((vFinishPos.z - FINISH_ZMIN) / FINISH_ZRANGE
      + 0.2 * (vFinishPos.x / FINISH_SCALE)
      + 0.12 * sin(uFinishTime * 0.5), 0.0, 1.0);
  float seg = gt * 1.000000;
  vec3 gradCol = vec3(0.973445, 0.361307, 0.520996);
  gradCol = mix(gradCol, vec3(1.000000, 0.296138, 0.018500), clamp(seg - 0.000000, 0.0, 1.0));

    diffuseColor.rgb *= gradCol;
  }
",
  "header": "#define FINISH_SCALE 42.000000
#define FINISH_ZMIN -7.500000
#define FINISH_ZRANGE 15.000000
uniform float uFinishTime;
varying vec3 vFinishPos;
",
  "light": "
  {
    vec3 silkDir = normalize(vViewPosition);
    float silkFres = pow(1.0 - abs(dot(silkDir, normalize(normal))), 2.5);
    float silkBand = 0.5 + 0.5 * sin(
      (vFinishPos.x + vFinishPos.y + 2.0 * vFinishPos.z) / FINISH_SCALE * 9.0
      + uFinishTime * 0.6);
    outgoingLight += vec3(0.661587, 0.696504, 0.861340) * silkFres * (0.12 + 0.28 * silkBand);
  }
",
}
`;

exports[`generated GLSL per finish > sparkle: snapshot, and every piece lands in three's shader 1`] = `
{
  "diffuse": "",
  "header": "#define FINISH_SCALE 42.000000
#define FINISH_ZMIN -7.500000
#define FINISH_ZRANGE 15.000000
uniform float uFinishTime;
varying vec3 vFinishPos;
",
  "light": "
  {
    vec3 sparkP = vFinishPos * 1.619048 + 0.000000;
    vec3 sparkCell = floor(sparkP);
    vec3 sparkRnd = finishHash3(sparkCell);
    // Facet orientation from a second, decorrelated hash so a fleck's angle is
    // independent of whether it exists and how big it is.
    vec3 sparkFacet = finishHash3(sparkCell + 5.3);
    vec3 sparkOff = fract(sparkP) - 0.5 - (sparkRnd - 0.5) * 0.55;
    float sparkRad = 0.160000 + 0.030000 * sparkRnd.y;
    // Flat core with a soft rim: the fleck reads as a solid round dot, and the
    // rim is just enough anti-aliasing to keep it from crawling.
    float sparkDisc = step(0.320000, sparkRnd.x)
      * (1.0 - smoothstep(sparkRad * 0.78, sparkRad, length(sparkOff)));
    vec3 sparkDir = normalize(vViewPosition);
    vec3 sparkNormal = normalize(normalize(normal) + (sparkFacet * 2.0 - 1.0) * 1.450000);
    // Thresholded rather than pow()-falloff: a facet is either catching the
    // light or it isn't, which is what makes a field of flecks read as glitter
    // instead of a soft specular haze. A tight pow() exponent would leave
    // almost every fleck dark on surfaces angled away from the camera.
    float sparkGlint = smoothstep(0.620000, 0.900000, max(dot(sparkDir, sparkNormal), 0.0));
    float sparkTwinkle = 1.0;
    vec3 sparkTint = vec3(1.0);
    outgoingLight += sparkTint * sparkGlint * sparkDisc * sparkTwinkle
      * 1.700000 * (0.6 + 0.8 * sparkFacet.z);
  }

  {
    vec3 sparkP = vFinishPos * 1.190476 + 17.000000;
    vec3 sparkCell = floor(sparkP);
    vec3 sparkRnd = finishHash3(sparkCell);
    // Facet orientation from a second, decorrelated hash so a fleck's angle is
    // independent of whether it exists and how big it is.
    vec3 sparkFacet = finishHash3(sparkCell + 5.3);
    vec3 sparkOff = fract(sparkP) - 0.5 - (sparkRnd - 0.5) * 0.55;
    float sparkRad = 0.115000 + 0.022000 * sparkRnd.y;
    // Flat core with a soft rim: the fleck reads as a solid round dot, and the
    // rim is just enough anti-aliasing to keep it from crawling.
    float sparkDisc = step(0.450000, sparkRnd.x)
      * (1.0 - smoothstep(sparkRad * 0.78, sparkRad, length(sparkOff)));
    vec3 sparkDir = normalize(vViewPosition);
    vec3 sparkNormal = normalize(normalize(normal) + (sparkFacet * 2.0 - 1.0) * 1.350000);
    // Thresholded rather than pow()-falloff: a facet is either catching the
    // light or it isn't, which is what makes a field of flecks read as glitter
    // instead of a soft specular haze. A tight pow() exponent would leave
    // almost every fleck dark on surfaces angled away from the camera.
    float sparkGlint = smoothstep(0.640000, 0.910000, max(dot(sparkDir, sparkNormal), 0.0));
    float sparkTwinkle = 1.0;
    vec3 sparkTint = vec3(1.0);
    outgoingLight += sparkTint * sparkGlint * sparkDisc * sparkTwinkle
      * 1.800000 * (0.6 + 0.8 * sparkFacet.z);
  }
",
}
`;

