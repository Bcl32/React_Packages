{
  "name": "@bcl32/makery",
  "version": "0.1.0",
  "description": "What Print-Tracker and the Almost Anything Makery shop share: how a filament looks (finish mapping, colour overrides, a finish-aware 2D swatch, three.js finish materials) and how a printed part is shown (millimetre geometry, scale objects, a dimension overlay)",
  "author": "",
  "license": "ISC",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./finishes": {
      "types": "./dist/finishes.d.ts",
      "import": "./dist/finishes.js"
    },
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "import": "./dist/geometry.js"
    },
    "./swatch": {
      "types": "./dist/swatch.d.ts",
      "import": "./dist/swatch.js"
    },
    "./materials": {
      "types": "./dist/materials.d.ts",
      "import": "./dist/materials.js"
    },
    "./reference": {
      "types": "./dist/reference.d.ts",
      "import": "./dist/reference.js"
    },
    "./dimensions": {
      "types": "./dist/dimensions.d.ts",
      "import": "./dist/dimensions.js"
    },
    "./swatch.css": "./src/swatch.css"
  },
  "files": [
    "dist",
    "src/swatch.css"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bcl32/React_Packages.git",
    "directory": "makery"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "three": "~0.172.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "~0.172.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "~0.172.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
